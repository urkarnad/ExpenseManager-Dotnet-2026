<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ExpensesManager.MyMauiApp.Pages.TransactionDetailsPage"
             Title="Transaction Details"
             BackgroundColor="#FFF0F5">

    <Grid>

        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="#C2185B"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           ZIndex="10"/>

        <ScrollView IsEnabled="{Binding IsNotBusy}">
            <VerticalStackLayout Padding="24" Spacing="16">

                <Label Text="Transaction Details"
                       FontSize="26" FontAttributes="Bold"
                       TextColor="#C2185B"
                       HorizontalOptions="Center"
                       Margin="0,10,0,10"/>

                <Frame BackgroundColor="White" CornerRadius="20" Padding="24"
                       BorderColor="#F48FB1" HasShadow="True">
                    <VerticalStackLayout Spacing="14">

                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Amount" FontSize="22"/>
                            <Label Text="{Binding Transaction.Amount, StringFormat='Amount: {0:F2}'}"
                                   FontSize="18" TextColor="#880E4F" FontAttributes="Bold"/>
                        </HorizontalStackLayout>
                        <BoxView HeightRequest="1" BackgroundColor="#F8BBD0"/>

                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Category" FontSize="22"/>
                            <Label Text="{Binding Transaction.Category, StringFormat='Category: {0}'}"
                                   FontSize="18" TextColor="#555"/>
                        </HorizontalStackLayout>
                        <BoxView HeightRequest="1" BackgroundColor="#F8BBD0"/>

                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Description" FontSize="22"/>
                            <Label Text="{Binding Transaction.Description, StringFormat='Description: {0}'}"
                                   FontSize="18" TextColor="#555"/>
                        </HorizontalStackLayout>
                        <BoxView HeightRequest="1" BackgroundColor="#F8BBD0"/>

                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Date" FontSize="22"/>
                            <Label Text="{Binding Transaction.Date, StringFormat='Date: {0:dd.MM.yyyy}'}"
                                   FontSize="18" TextColor="#555"/>
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Frame>

                <Frame BackgroundColor="#FCE4EC" CornerRadius="16" Padding="18"
                       BorderColor="#F48FB1" HasShadow="True">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Edit Transaction"
                               FontSize="18" FontAttributes="Bold" TextColor="#C2185B"/>

                        <Label Text="Amount" TextColor="#880E4F" FontSize="14"/>
                        <Entry Placeholder="Amount"
                               Text="{Binding EditAmount}"
                               Keyboard="Numeric"
                               BackgroundColor="White" TextColor="#880E4F"/>

                        <Label Text="Description" TextColor="#880E4F" FontSize="14"/>
                        <Entry Placeholder="Description"
                               Text="{Binding EditDescription}"
                               BackgroundColor="White" TextColor="#880E4F"/>

                        <Label Text="Category" TextColor="#880E4F" FontSize="14"/>
                        <Picker ItemsSource="{Binding Categories}"
                                SelectedItem="{Binding EditCategory}"
                                TextColor="#880E4F"/>

                        <Button Text="Save Changes"
                                Command="{Binding SaveCommand}"
                                BackgroundColor="#C2185B"
                                TextColor="White"
                                CornerRadius="12"
                                Margin="0,6,0,0"/>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>