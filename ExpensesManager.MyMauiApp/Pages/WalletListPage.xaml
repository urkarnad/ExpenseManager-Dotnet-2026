<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ExpensesManager.MyMauiApp.Pages.WalletListPage"
             Title="My Wallets"
             BackgroundColor="#FFF0F5">

    <Grid RowDefinitions="*">

        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="#C2185B"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           ZIndex="10"/>

        <ScrollView IsEnabled="{Binding IsNotBusy}">
            <VerticalStackLayout Padding="20" Spacing="12">

                <Label Text="My Wallets"
                       FontSize="30"
                       FontAttributes="Bold"
                       TextColor="#C2185B"
                       HorizontalOptions="Center"
                       Margin="0,10,0,4"/>

                <Frame BackgroundColor="White" CornerRadius="14" Padding="14" BorderColor="#F48FB1">
                    <VerticalStackLayout Spacing="8">
                        <Entry Placeholder="Search wallets..."
                               Text="{Binding SearchText}"
                               BackgroundColor="Transparent"
                               TextColor="#880E4F"/>
                        <Picker Title="Sort by"
                                ItemsSource="{Binding SortOptions}"
                                SelectedItem="{Binding SelectedSort}"
                                TextColor="#880E4F"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame BackgroundColor="#FCE4EC" CornerRadius="14" Padding="14" BorderColor="#F48FB1">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Add New Wallet"
                               FontSize="16" FontAttributes="Bold" TextColor="#C2185B"/>
                        <Entry Placeholder="Wallet name"
                               Text="{Binding NewWalletName}"
                               BackgroundColor="White"
                               TextColor="#880E4F"/>
                        <Picker Title="Currency"
                                ItemsSource="{Binding Currencies}"
                                SelectedItem="{Binding NewWalletCurrency}"
                                TextColor="#880E4F"/>
                        <Button Text="Add Wallet"
                                Command="{Binding AddWalletCommand}"
                                BackgroundColor="#C2185B"
                                TextColor="White"
                                CornerRadius="10"/>
                    </VerticalStackLayout>
                </Frame>

                <CollectionView ItemsSource="{Binding Wallets}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame BackgroundColor="#FCE4EC"
                                   CornerRadius="16"
                                   Padding="18,14"
                                   Margin="0,5"
                                   BorderColor="#F48FB1"
                                   HasShadow="True">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectWalletCommand}"
                                            CommandParameter="{Binding .}"/>
                                    </Grid.GestureRecognizers>

                                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                        <Label Text="{Binding Name}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="#880E4F"/>
                                    </VerticalStackLayout>

                                    <Button Grid.Column="1"
                                            Text="Trash!"
                                            BackgroundColor="Transparent"
                                            TextColor="#E91E63"
                                            FontSize="20"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteWalletCommand}"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>